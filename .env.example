# ============================================================
# PYQVERSE - Environment Variable Template
# Copy this file to `.env` in the project root and fill values.
# NEVER commit your real `.env` file or secrets.
# ============================================================

# Database (PostgreSQL + pgvector - future phases)
DATABASE_URL=postgresql+psycopg://pyqverse:password@localhost:5432/pyqverse

# Cloud AI API (future phases)
AI_API_KEY=your_ai_api_key_here

# Local AI via Ollama (future phases)
OLLAMA_BASE_URL=http://localhost:11434

# Frontend origin used for CORS
FRONTEND_URL=http://localhost:5173
